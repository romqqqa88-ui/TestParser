APP_ENV=dev
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/avito_parser
ALEMBIC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/avito_parser

REQUEST_TIMEOUT=20
REQUEST_RETRIES=3
REQUEST_DELAY_SECONDS=1.0
REQUEST_BACKOFF_MULTIPLIER=2.0
REQUEST_JITTER_SECONDS=0.3
REQUEST_MAX_BACKOFF_SECONDS=20.0
REQUEST_RETRY_STATUSES=429,403,503
HTTP_BACKEND=httpx
CURL_IMPERSONATE=chrome124
MAX_PAGES_PER_QUERY=5
MAX_CONCURRENCY=5
USER_AGENT=Mozilla/5.0
USER_AGENT_POOL=
BROWSER_HEADERS_ENABLED=true

PROXY_ENABLED=false
PROXY_LIST=
PROXY_ROTATE_ON_RETRY=true

EXPORT_DIR=exports
EXPORT_MAX_ROWS_PER_FILE=50000

SCHEDULER_ENABLED=false
SCHEDULER_TIMEZONE=Europe/Moscow
