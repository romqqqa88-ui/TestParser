APP_ENV=dev
RUNTIME_PROFILE=default
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/avito_parser
ALEMBIC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/avito_parser

REQUEST_TIMEOUT=20
REQUEST_TIMEOUT_MIN_SECONDS=1.0
REQUEST_TIMEOUT_BACKOFF_MULTIPLIER=1.0
REQUEST_TIMEOUT_MAX_SECONDS=20.0
REQUEST_RETRIES=6
REQUEST_DELAY_SECONDS=2.0
REQUEST_MIN_RETRY_DELAY_SECONDS=0.2
REQUEST_BACKOFF_MULTIPLIER=2.0
REQUEST_JITTER_SECONDS=0.3
REQUEST_APPLY_JITTER_TO_RETRY_AFTER=false
REQUEST_MAX_BACKOFF_SECONDS=90.0
REQUEST_RETRY_AFTER_MAX_SECONDS=120.0
REQUEST_RETRY_STATUSES=429,403,503
REQUEST_RETRY_ON_STATUSES=true
REQUEST_RETRY_ON_EXCEPTIONS=true
HTTP_BACKEND=httpx
HTTP_BACKEND_AUTO_ORDER=curl_cffi,httpx
CURL_IMPERSONATE=chrome124
CURL_IMPERSONATE_POOL=chrome124,chrome123,chrome120
MAX_PAGES_PER_QUERY=5
MAX_CONCURRENCY=5
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36
USER_AGENT_POOL=
BROWSER_HEADERS_ENABLED=true

# Optional: Cookie string from DevTools (Application -> Cookies) for www.avito.ru — reduces many 429 without paid APIs.
REQUEST_COOKIE=

# Optional: UTF-8 file with the same Cookie string (refresh via: python scripts/fetch_avito_cookies.py).
REQUEST_COOKIE_FILE=

PROXY_ENABLED=false
PROXY_LIST=
PROXY_ROTATE_ON_RETRY=true

EXPORT_DIR=exports
EXPORT_MAX_ROWS_PER_FILE=50000
NEW_LISTINGS_FILE=new_listings.jsonl
DB_RETRIES=2
DB_RETRY_DELAY_SECONDS=0.5
DB_RETRY_BACKOFF_MULTIPLIER=2.0
DB_RETRY_JITTER_SECONDS=0.2

SCHEDULER_ENABLED=false
SCHEDULER_TIMEZONE=Europe/Moscow

# Quasi-real-time profile for Avito (recommended):
# RUNTIME_PROFILE=quasi_realtime
# It auto-applies safer defaults:
# - REQUEST_RETRIES=2
# - REQUEST_DELAY_SECONDS=3.0
# - REQUEST_MIN_RETRY_DELAY_SECONDS=0.8
# - REQUEST_BACKOFF_MULTIPLIER=2.5
# - REQUEST_JITTER_SECONDS=1.2
# - REQUEST_MAX_BACKOFF_SECONDS=180.0
# - REQUEST_RETRY_AFTER_MAX_SECONDS=240.0
# - MAX_CONCURRENCY=1
# - MAX_PAGES_PER_QUERY=2
# - SCHEDULER_INTERVAL_MINUTES=1
